{
  "name": "@mahiframework/storage-sftp",
  "version": "0.2.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/prune-dist.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@mahiframework/core": "workspace:*",
    "@mahiframework/storage": "workspace:*"
  },
  "peerDependencies": {
    "ssh2": "^1.16.0"
  },
  "peerDependenciesMeta": {
    "ssh2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.5",
    "ssh2": "^1.17.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "author": "Bradie Tilley",
  "homepage": "https://github.com/mahiframework/mahi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahiframework/mahi.git",
    "directory": "framework/storage-sftp"
  },
  "bugs": {
    "url": "https://github.com/mahiframework/mahi/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "sideEffects": false,
  "description": "Storage (SFTP) — an SFTP storage driver for Mahi, for files on a remote host.",
  "keywords": [
    "mahi",
    "storage",
    "sftp",
    "ssh",
    "remote"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
