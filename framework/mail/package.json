{
  "name": "@mahiframework/mail",
  "version": "0.1.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/prune-dist.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@mahiframework/core": "workspace:*",
    "@mahiframework/facades": "workspace:*",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.19.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "author": "Bradie Tilley",
  "homepage": "https://github.com/mahiframework/mahi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahiframework/mahi.git",
    "directory": "framework/mail"
  },
  "bugs": {
    "url": "https://github.com/mahiframework/mahi/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "sideEffects": false,
  "description": "Mail — mailables and transports for sending email from Mahi.",
  "keywords": [
    "mahi",
    "mail",
    "email",
    "mailable",
    "smtp"
