    "@mahiframework/http-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "author": "Bradie Tilley",
  "homepage": "https://github.com/mahiframework/mahi#readme",
