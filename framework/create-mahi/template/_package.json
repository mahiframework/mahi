{
  "name": "mahi-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsx watch --include .env bin/console.ts serve --no-reload",
    "start": "node dist/bin/server.js",
    "console": "tsx bin/console.ts"
  },
  "dependencies": {
    "@mahiframework/auth": "^0.1.4",
    "@mahiframework/authorization": "^0.1.4",
    "@mahiframework/broadcasting": "^0.1.4",
    "@mahiframework/cache": "^0.1.4",
    "@mahiframework/cli": "^0.1.4",
    "@mahiframework/core": "^0.1.4",
    "@mahiframework/database": "^0.1.4",
    "@mahiframework/datetime": "^0.1.4",
    "@mahiframework/encryption": "^0.1.4",
    "@mahiframework/events": "^0.1.4",
    "@mahiframework/health": "^0.1.4",
    "@mahiframework/http": "^0.1.4",
    "@mahiframework/mail": "^0.1.4",
    "@mahiframework/notifications": "^0.1.4",
    "@mahiframework/queue": "^0.1.4",
    "@mahiframework/redis": "^0.1.4",
    "@mahiframework/schedule": "^0.1.4",
    "@mahiframework/snowflake": "^0.1.4",
    "@mahiframework/storage": "^0.1.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mahiframework/testing": "^0.1.4",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
