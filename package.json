{
  "name": "mahi",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=4",
    "lint": "turbo run lint --concurrency=4",
    "typecheck": "turbo run typecheck",
    "format": "eslint . --fix && prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "test:integration": "docker compose up -d --wait && CI_STRICT_MODE=true turbo run test --concurrency=4",
    "metadata": "node scripts/sync-package-metadata.mjs",
    "metadata:check": "node scripts/sync-package-metadata.mjs --check",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check",
    "pack:check": "node scripts/check-pack.mjs",
    "publish:check": "node scripts/check-publishable.mjs"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "vite": "^8.3.3"
    }
  }
}
